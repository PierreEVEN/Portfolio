<div class="project">
    <div class="h-separator">
        <div></div>
    </div>
    <div class="content">

        <div class="general" onclick="{{ctx 'expand()'}}" {{object "general"}}>

            <div class="project-picture">
                <img src="{{image}}" alt="{{title}}">

                <div class="title">
                    <h2>{{title}}</h2>
                    <p>{{category}}</p>
                    <img alt="right" src="/public/images/icons/icons8-right-arrow-60.webp">
                </div>

                <div class="image-footer">
                    <img alt="time" src="/public/images/icons/icons8-time-48.webp">
                    <p>{{duration}} &emsp;|</p>
                    <img alt="tools" src="/public/images/icons/icons8-tools-48.webp">
                    <p>{{graphics}} ({{languages}})</p>
                </div>
            </div>
        </div>

        <div class="details" {{object "details"}}></div>
    </div>
</div>