<div class="project-main">
    <div class="project-infos">
        <div class="description">
            <p>{{description}}</p>

            {{#if link}}
                <div class="url" onclick="window.open('{{link}}', '_blank').focus();">
                    <img alt="tools" src="/public/images/icons/icons8-url-50.webp">
                    <a href="{{link}}" onclick="event.preventDefault();">{{link}}</a>
                </div>
            {{/if}}

            <div class="stats">
                {{#if start}}
                    {{#if end}}
                        <div>
                            <img alt="start" src="/public/images/icons/icons8-calendar-48.webp">
                            <p>{{start}} - {{end}}</p>
                        </div>
                    {{/if}}
                {{/if}}
    {{#if libs}}
                <div>
                    <img alt="deps" src="/public/images/icons/icons8-tree-structure-48.webp">
                    <p>{{libs}}</p>
                </div>
    {{/if}}
            </div>
        </div>
    </div>

    <div class="project-features">
        {{#if features}}
            <div class="features">
                {{#each features}}
                    <div class="feature">
                        <div class="base_description">
                            <h4>{{name}}</h4>
                            <p>{{description}}</p>
                        </div>
                        {{#if image}}
                            <img alt="name" src="{{image}}">
                        {{/if}}
                    </div>
                {{/each}}
            </div>
        {{/if}}
    </div>

    <div class="project-gallery">
        {{#each gallery}}
            <div class="gallery-item">
                {{#if image}}<img src="{{image}}" alt="">{{/if}}
                {{#if youtube}}
                    <iframe width="100%" height="250px" src="{{youtube}}" allowfullscreen></iframe>{{/if}}
            </div>
        {{/each}}
    </div>
</div>