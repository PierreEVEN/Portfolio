<div class="main dark-background">
    <div class="main-title">
        <img src="/public/images/pfp.webp" alt="profile picture">
        <div class="main-subtitle">
            <h1>Pierre EVEN</h1>
            <h2>Engine Programmer</h2>
        </div>
    </div>

    <p>
        Hi!<br>
        I'm Pierre EVEN, a versatile hard-working programmer specialized in game engine development.<br>
        Recently graduated with a master's degree, and also a passionate music player, I'm spending this full year
        at the Jazz department of the conservatory of Strasbourg to perfect my guitar playing.
    </p>
    <div class="first-section">
        <div class="section" onclick="{{ctx 'goto(event, `projects`)'}}">
            <img alt="three flight simulator" src="/public/images/projects.webp">
            <div class="section-content">
                <h1>Some personal works, projects and more !</h1>
                <div class="section-panel">
                    <div class="section-overlay">
                        <h2>Step into my universe !</h2>
                    </div>
                </div>
            </div>
            <img class="clicky" src="/public/images/icons/clicky.gif">
        </div>
    </div>

    <div class="sections">
        <div class="section" onclick="window.open('https://flightsim.evenpierre.fr', '_blank').focus();">
            <img alt="three flight simulator" src="/public/images/tfs.webp">
            <div class="section-content">
                <h1>In the mood for a quick flight ?</h1>
                <div class="section-description">
                    <p>Take a seat aboard a mighty F-16 and travel through the infinity inside your navigator</p>
                    <p class="small">(Don't forget your barf bag)</p>
                    <h2>Click to play !</h2>
                </div>
            </div>
        </div>

        <div class="section" onclick="window.open('https://fileshare.evenpierre.fr', '_blank').focus();">
            <img alt="three flight simulator" src="/public/images/fileshare.webp">
            <div class="section-content">
                <h1>Needs some online storage ?</h1>
                <div class="section-description">
                    <p>Fileshare is a fully homemade online cloud storage solution</p>
                    <h2>Click to visit !</h2>
                </div>
            </div>
        </div>
    </div>
</div>